---
import type { BenchmarkResultRow } from "../lib/benchmark-hub";

interface Props {
  rows: BenchmarkResultRow[];
  heading: string;
}

const { rows, heading } = Astro.props;
---

<div class="copy-md-control hidden shrink-0 md:inline-flex">
  <button
    type="button"
    class="copy-md-btn copy-md-main"
    aria-label="Copy markdown"
    data-rows={JSON.stringify(rows)}
    data-heading={heading}
  >
    <span class="copy-md-icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-3 w-3"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
    </span>
    <span class="copy-md-label">Copy markdown</span>
  </button>
</div>

<script>
  function formatReportedDate(reportedAt?: string): string {
    if (!reportedAt) return "—";

    const dateInput = /^\d{4}-\d{2}$/.test(reportedAt) ? `${reportedAt}-01` : reportedAt;
    const date = new Date(`${dateInput}T00:00:00Z`);
    if (Number.isNaN(date.getTime())) return reportedAt;

    return date.toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    });
  }

  function buildMarkdown(btn: HTMLButtonElement): string {
    const rows = JSON.parse(btn.dataset.rows ?? "[]") as {
      rank: number;
      systemName: string;
      organization: string;
      scoreDisplay: string;
      reportedAt?: string;
      notesShort: string;
      sourceUrl: string;
      repoUrl?: string;
    }[];
    const heading = btn.dataset.heading ?? "Leaderboard";

    const header = `| System | Organization | Score | Reported | Notes | Source | Repo |`;
    const divider = `| --- | --- | --- | --- | --- | --- | --- |`;
    const rowLines = rows.map(
      (r) =>
        `| ${r.systemName} | ${r.organization} | ${r.scoreDisplay} | ${formatReportedDate(r.reportedAt)} | ${r.notesShort} | [Source](${r.sourceUrl}) | ${r.repoUrl ? `[Repo](${r.repoUrl})` : "—"} |`
    );

    return [`## ${heading}`, ``, header, divider, ...rowLines].join("\n");
  }

  document.querySelectorAll<HTMLButtonElement>(".copy-md-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(buildMarkdown(btn)).then(() => {
        const label = btn.querySelector<HTMLElement>(".copy-md-label");
        const original = label ? label.textContent : btn.textContent;
        if (label) {
          label.textContent = "Copied";
        } else {
          btn.textContent = "Copied";
        }
        setTimeout(() => {
          if (label) {
            label.textContent = original;
          } else {
            btn.textContent = original;
          }
        }, 1800);
      });
    });
  });
</script>

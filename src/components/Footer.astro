---
import { getAllBenchmarkPages } from "../lib/benchmark-hub";

const lastUpdated = getAllBenchmarkPages()
  .map((page) => page.meta.lastUpdated)
  .sort()
  .at(-1);

const currentTime = new Date(
  `${lastUpdated ?? new Date().toISOString().slice(0, 10)}T00:00:00Z`
).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<footer class="pb-8">
  <div
    class="flex flex-col gap-2 border-t border-[var(--color-border-subtle)] pt-4 text-xs md:flex-row md:items-center md:justify-between"
  >
    <div class="muted">Last updated: {currentTime}</div>
    <div>
      <a
        href="https://steel.dev?utm_source=leaderboard&utm_medium=website&utm_content=footer"
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline text-[var(--color-text)] hover:text-[var(--color-text-strong)]"
        >Steel.dev</a
      >
    </div>
    <div>
      <a
        href="https://github.com/steel-dev/leaderboard/tree/main/src/data"
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline text-[var(--color-text)] hover:text-[var(--color-text-strong)]"
        >Contribute</a
      >
    </div>
  </div>
</footer>

---
// ABOUTME: Callout promoting Atlas, Steel's open-source research agent.
// ABOUTME: Rendered under the leaderboard table on research benchmark detail pages.
import { ATLAS_REPO_URL, ATLAS_INSTALL } from "../lib/atlas";

interface Props {
  note?: string;
  class?: string;
}

const { note, class: className } = Astro.props;

const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>`;

const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>`;

const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
---

<aside class:list={["atlas-callout", "section-frame", className]}>
  <h2 class="atlas-callout-title">Build your own deep research agent — on any of these models</h2>
  <p class="atlas-callout-body">
    <a href={ATLAS_REPO_URL} target="_blank" rel="noopener">Atlas</a> is Steel&rsquo;s open-source deep
    research harness. Pick any model from this board for the lead, route the rest by role, and Atlas runs
    the loop end to end — planning, search, browser fetch, claim verification, and a cited report. Your
    models, your budget; the harness is open source.
    {note && <> {note}</>}
  </p>
  <div class="atlas-callout-actions">
    <button
      type="button"
      class="atlas-install code-inline"
      data-copy={ATLAS_INSTALL}
      aria-label="Copy install command"
    >
      <code>{ATLAS_INSTALL}</code>
      <span class="atlas-copy-icon" aria-hidden="true"><Fragment set:html={copyIcon} /></span>
      <span class="atlas-copy-check" aria-hidden="true"><Fragment set:html={checkIcon} /></span>
    </button>
    <a href={ATLAS_REPO_URL} target="_blank" rel="noopener" class="btn-primary atlas-github">
      <Fragment set:html={githubIcon} />
      View Atlas on GitHub
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</aside>

<style>
  .atlas-callout {
    padding: 1.25rem;
  }

  .atlas-callout-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-strong);
    letter-spacing: -0.02em;
  }

  .atlas-callout-body {
    margin: 0.5rem 0 0;
    max-width: 44rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
    color: var(--color-text-muted);
  }

  .atlas-callout-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .atlas-github {
    margin-left: auto;
  }

  .atlas-install {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text);
    cursor: pointer;
    transition: color 120ms ease;
  }

  .atlas-install:hover {
    color: var(--color-text-strong);
  }

  .atlas-install code {
    font-family: inherit;
  }

  .atlas-install .atlas-copy-icon,
  .atlas-install .atlas-copy-check {
    display: inline-flex;
    color: var(--color-text-dim);
  }

  .atlas-install:hover .atlas-copy-icon {
    color: var(--color-text);
  }

  .atlas-install .atlas-copy-check {
    display: none;
    color: var(--color-accent);
  }

  .atlas-install.is-copied .atlas-copy-icon {
    display: none;
  }

  .atlas-install.is-copied .atlas-copy-check {
    display: inline-flex;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".atlas-install").forEach((btn) => {
    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(btn.dataset.copy ?? "").then(() => {
        btn.classList.add("is-copied");
        setTimeout(() => btn.classList.remove("is-copied"), 1600);
      });
    });
  });
</script>
